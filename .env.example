# Copier en .env puis `set -a; source .env; set +a` (facultatif : valeurs par défaut = dossiers du dépôt)
# GWT_DATA_DIR=./data
# GWT_DATASET_DIR=./data/simple_shapes_dataset
# GWT_EVALSET_DIR=./data/evaluation_set
# GWT_PRETRAINED_DIR=./checkpoints/pretrained
# GWT_RUNS_DIR=./checkpoints/runs
# GWT_RESULTS_DIR=./results

# Version modifiée de shimmer-ssd utilisée pendant le stage
SHIMMER_SSD_FORK=git+https://github.com/aemanuelli/shimmer-ssd.git@gwt-synesthesia

# Optionnel : version modifiée de shimmer, si elle diffère du commit figé dans requirements.txt
# SHIMMER_FORK=git+https://github.com/aemanuelli/shimmer.git@gwt-synesthesia

# Optionnel : logging W&B en ligne (sinon mode offline)
# WANDB_API_KEY=
